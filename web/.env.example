# Wiring a real Supabase project is an env-var change, not a rewrite:
# with these two set, every read in src/lib/data/ hits the live views.
# With them absent the app serves typed fixtures and says so in a banner.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used to build the magic-link redirect. Vercel sets
# VERCEL_URL automatically; set this only for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate — the pipeline's publish webhook
# (§2.3, §5). Without it the endpoint refuses every request with 503.
REVALIDATE_SECRET=
