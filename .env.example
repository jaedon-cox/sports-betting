# Local development only — copy to `.env` (gitignored).
#
# NOTHING IN src/ LOADS THIS FILE. `store/client.py` and `jobs/config.py` read
# os.environ directly and there is no python-dotenv dependency, so you must
# export it yourself before running a job:
#
#     set -a; source .env; set +a
#     python -m sbm.jobs h
#
# In production these are GitHub Actions Secrets and Variables, never a file
# on disk. See .github/workflows/README.md for which job needs which.

# --- Secrets: no defaults, a job pointed at nothing must fail loudly ---------

# Supabase → Project Settings → API. `https://<ref>.supabase.co`, no path;
# PostgrestClient appends /rest/v1 itself.
SUPABASE_URL=

# Supabase → Project Settings → API Keys → `service_role` (may be labelled
# "secret"). Bypasses RLS (§5) and is the only key granted EXECUTE on the
# pipeline's Postgres functions. Server-side only — never the web app.
SUPABASE_SERVICE_ROLE_KEY=

# the-odds-api.com → free tier. 500 requests/month, the tightest constraint in
# the system (§2.5). Jobs A and E only.
ODDS_API_KEY=

# Your Vercel origin, no trailing path. Jobs A, D, E, F purge the frontend
# cache through it.
SITE_URL=

# Any long random string — `openssl rand -hex 32`. Must match the web app's
# REVALIDATE_SECRET byte for byte or every purge 401s.
REVALIDATE_SECRET=

# --- Knobs: all optional, all default to the doc's own numbers ---------------
# In production these belong in Actions *Variables*, not Secrets — they are not
# sensitive and are useful visible in a run log. Empty is treated as absent.

# SBM_SPORT=mlb
# SBM_EDGE_THRESHOLD=0.0        # no doc gives this number; see jobs/config.py
# SBM_KELLY_FRACTION=0.25       # 25% fractional Kelly (model doc §7)
# SBM_N_DRAWS=100000            # draws/game/side (§2.2)
# SBM_DAILY_ODDS_CREDITS=15     # 1 open + 4 closing sweeps/day (§2.5)

# GITHUB_SHA and GITHUB_RUN_ID are supplied by Actions — do not set them here.
# Locally git_sha falls back to 'local' so a dev run cannot register itself as
# a real commit in `model_versions`.
